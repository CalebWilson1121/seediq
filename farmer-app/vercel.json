{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {"source": "/api/:path*", "destination": "https://seediq-green.vercel.app/api/:path*"},
    {"source": "/styles.css", "destination": "https://seediq-green.vercel.app/styles.css"},
    {"source": "/activity.js", "destination": "https://seediq-green.vercel.app/activity.js"},
    {"source": "/acrefit-logo.svg", "destination": "https://seediq-green.vercel.app/acrefit-logo.svg"},
    {"source": "/acrefit-logo-light.svg", "destination": "https://seediq-green.vercel.app/acrefit-logo-light.svg"}
  ]
}